{
    "name": "imrandevbd/drutogoti",
    "description": "Local Laravel 13 compatibility shim for Drutogoti speed toolkit (upstream targets illuminate ^11|^12).",
    "type": "library",
    "version": "dev-main",
    "license": "MIT",
    "authors": [{"name": "Imran Ahmed", "email": "me@imrandev.bd", "homepage": "https://imrandev.bd"}],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "ImranDevBd\\Drutogoti\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["ImranDevBd\\Drutogoti\\ServiceProvider"]
        }
    },
    "minimum-stability": "dev"
}
