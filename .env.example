APP_NAME=AppointRemind
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@appointremind.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Module toggles (see config/modules.php)
MODULE_APPOINTMENTS=true
MODULE_SCHEDULING=true
MODULE_REMINDERS=true
MODULE_WAITLIST=true
MODULE_NO_SHOW=true
MODULE_SERVICES=true
MODULE_PROVIDERS=true
MODULE_CLIENT_PORTAL=true
MODULE_AI_SCHEDULING=true
MODULE_PDF_EXPORTS=true
MODULE_CATALOG_SCRAPE=false
MODULE_ATTENDANCE_OPS=false
MODULE_SPEED_OPTIMIZER=true

# Demo credentials
DEMO_EMAIL=demo@appointremind.test
DEMO_PASSWORD=password

APPOINT_DEFAULT_REMINDER_HOURS=24
APPOINT_CONFIRMATION_WINDOW_HOURS=48
APPOINT_NO_SHOW_RISK_THRESHOLD=0.55